rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- TEAM LIST ----
    // Put the Google (Gmail) address of everyone who may use Gait Check
    // here, in lower case, in quotes, separated by commas. Then click Publish.
    function onTeam() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'your.email@gmail.com',
          'second.person@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if onTeam();
    }
  }
}
